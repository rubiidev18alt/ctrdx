<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Keep Android RID restore from acquiring a runtime pack for this
         RID-agnostic library; the Android application supplies the runtime. -->
    <EnableRuntimePackDownload Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('android-'))">false</EnableRuntimePackDownload>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <ProjectReference Include="../CutTheRopeDX.Core/CutTheRopeDX.Core.csproj" />
    <InternalsVisibleTo Include="CutTheRopeDX.Browser" />
    <InternalsVisibleTo Include="CutTheRopeDX.Android" />
    <InternalsVisibleTo Include="CutTheRope-DX" />
    <InternalsVisibleTo Include="CutTheRopeDX.Desktop.Tests" />
    <InternalsVisibleTo Include="CutTheRopeDX.Rendering.Skia.Tests" />
  </ItemGroup>
</Project>
