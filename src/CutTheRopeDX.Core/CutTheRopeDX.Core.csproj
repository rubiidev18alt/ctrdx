<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CutTheRopeDX</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- NuGet restore can flow the application's Android RID into this portable
         ProjectReference. The library is built without a RID, so it must not
         download an unavailable Android runtime pack of its own. -->
    <EnableRuntimePackDownload Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('android-'))">false</EnableRuntimePackDownload>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CutTheRope-DX" />
    <InternalsVisibleTo Include="CutTheRopeDX.Tests" />
    <InternalsVisibleTo Include="CutTheRopeDX.Desktop.Tests" />
    <InternalsVisibleTo Include="CutTheRopeDX.Browser" />
    <InternalsVisibleTo Include="CutTheRopeDX.Android" />
    <InternalsVisibleTo Include="CutTheRopeDX.Android.Tests" />
    <InternalsVisibleTo Include="CutTheRopeDX.Rendering.Skia" />
    <InternalsVisibleTo Include="CutTheRopeDX.Rendering.Skia.Tests" />
    <InternalsVisibleTo Include="CutTheRopeDX.Desktop.Platform" />
    <InternalsVisibleTo Include="CutTheRopeDX.Desktop.Platform.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
